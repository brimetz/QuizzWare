<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:QuizzWare.Views"
       x:Class="QuizzWare.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Background}"
       Shell.ForegroundColor="{StaticResource TextPrimary}"
       Shell.TitleColor="{StaticResource TextPrimary}">

    <ShellContent Title="QuizzWare"
                  ContentTemplate="{DataTemplate views:HomePage}"
                  Route="home" />

</Shell>
