<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 (sans plateforme) : bibliothèque utilisée par les tests unitaires de l'application (tests/QuizzWare.App.Tests). -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>QuizzWare</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Les bindings XAML avec x:DataType sont compilés (plus rapides, erreurs détectées au build). -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- MVVMTK0045 : [ObservableProperty] sur des champs n'est pas compatible AOT sous WinUI.
         CsWinRT1032 : expressions de collection vers une interface en lecture seule, même limite AOT sous WinUI.
         La cible Windows ne sert qu'au dev (pas de publication AOT), on garde donc ces syntaxes. -->
    <NoWarn>$(NoWarn);MVVMTK0045;CsWinRT1032</NoWarn>

    <ApplicationTitle>QuizzWare</ApplicationTitle>
    <ApplicationId>com.quizzware.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows : exécution non packagée, pratique pour tester rapidement sur le PC de dev. -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Abonnement Premium proposé ? Tant que false : les catégories Premium restent visibles, marquées « À venir »,
         sans achat possible, et le plugin de paiement n'est pas inclus dans l'application. true : définit PREMIUM. -->
    <PremiumOffered>false</PremiumOffered>
    <DefineConstants Condition="'$(PremiumOffered)' == 'true'">$(DefineConstants);PREMIUM</DefineConstants>
  </PropertyGroup>

  <!-- Publication Play Store : bundle .aab signé. Voir docs/PUBLICATION.md.
       Le chemin de la keystore et son mot de passe viennent de variables d'environnement : aucun secret dans le dépôt. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(QUIZZWARE_KEYSTORE)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(QUIZZWARE_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>quizzware</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:QUIZZWARE_KEYSTORE_PASS</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:QUIZZWARE_KEYSTORE_PASS</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F1221" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1221" BaseSize="128,128" />
    <!-- Sons générés par tools/GenerateurSons.ps1 -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Polices d'accessibilité (SIL Open Font License 1.1, licences dans le même dossier) -->
    <MauiFont Include="Resources\Fonts\*.ttf;Resources\Fonts\*.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
  </ItemGroup>

  <!-- Notifications locales (rappels quotidiens) et Google Play Billing / StoreKit : Android et iOS seulement. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PackageReference Include="Plugin.LocalNotification" Version="14.2.0" />
    <PackageReference Include="Plugin.InAppBilling" Version="11.0.1" Condition="'$(PremiumOffered)' == 'true'" />
  </ItemGroup>

  <!-- Google Play Billing (via Plugin.InAppBilling) demande des AndroidX plus récents que ceux de MAUI 10 :
       on les référence directement, toutes alignées, pour lever le conflit de versions (NU1107). -->
  <ItemGroup Condition="'$(PremiumOffered)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
  </ItemGroup>

  <!-- Manifeste de confidentialité exigé par l'App Store (API à « raison déclarée » utilisées par .NET et MAUI). -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuizzWare.Core\QuizzWare.Core.csproj" />
  </ItemGroup>

</Project>
