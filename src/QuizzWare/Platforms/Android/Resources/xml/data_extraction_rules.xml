<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : mêmes règles pour la sauvegarde dans le cloud et le transfert vers un nouvel appareil. -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="sharedpref" path="com.quizzware.app.microsoft.maui.essentials.preferences.xml" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="sharedpref" path="com.quizzware.app.microsoft.maui.essentials.preferences.xml" />
	</device-transfer>
</data-extraction-rules>
