<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizzWare.ViewModels"
             x:Class="QuizzWare.Views.ResultPage"
             x:DataType="vm:ResultViewModel"
             Title="Résultats">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,32,16,16" Spacing="20">

                <VerticalStackLayout x:Name="ScoreBlock" Spacing="6" HorizontalOptions="Center">
                    <Label Text="{Binding Headline}" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ScoreText}" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding XpText}" TextColor="{DynamicResource Warning}" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Bilan d'examen : entretien ou test de niveau -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasReport}" Stroke="{DynamicResource Primary}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ReportTitle}" Style="{StaticResource SubHeaderLabel}" TextColor="{DynamicResource Primary}" />
                        <Label Text="{Binding ReportDetails}" Style="{StaticResource BodyLabel}" />
                        <Label Text="À retravailler" Style="{StaticResource SubHeaderLabel}" FontSize="{DynamicResource FontSizeBody}"
                               IsVisible="{Binding HasWeakTopics}" Margin="0,6,0,0" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeakTopics}" Spacing="4" IsVisible="{Binding HasWeakTopics}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" Style="{StaticResource BodyLabel}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsLevelUp}"
                        BackgroundColor="{DynamicResource PrimaryDark}" Stroke="{DynamicResource Primary}">
                    <Label Text="{Binding LevelUpText}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasLevel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding LevelText}" Style="{StaticResource SubHeaderLabel}" />
                        <ProgressBar Progress="{Binding LevelProgress}" />
                        <Label Text="{Binding LevelXpText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding DailyGoalText}" Style="{StaticResource SubHeaderLabel}" />
                        <ProgressBar Progress="{Binding DailyGoalProgress}" ProgressColor="{Binding DailyGoalColor}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding LessonText}" TextColor="{Binding LessonColor}" FontSize="{DynamicResource FontSizeReading}"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding StreakText}" Style="{StaticResource MutedLabel}" FontSize="{DynamicResource FontSizeReading}"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{DynamicResource Background}" StrokeThickness="0" Padding="16,12,16,20">
            <Button Text="Continuer" Command="{Binding ContinueCommand}" />
        </Border>

        <!-- Confettis, par-dessus la page sans bloquer les touches -->
        <AbsoluteLayout x:Name="Confetti" Grid.RowSpan="2" InputTransparent="True" />
    </Grid>

</ContentPage>
