<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizzWare.ViewModels"
             xmlns:controls="clr-namespace:QuizzWare.Views.Controls"
             x:Class="QuizzWare.Views.LessonPage"
             x:DataType="vm:LessonViewModel"
             Title="Cours">

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,24" Spacing="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" FontSize="26" />
                    <Label Text="{Binding Summary}" Style="{StaticResource MutedLabel}" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SectionItem">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding Title}" Style="{StaticResource SubHeaderLabel}" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding Body}" Style="{StaticResource BodyLabel}" />
                                    <controls:CodeBlockView Lines="{Binding CodeLines}" IsVisible="{Binding HasCode}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Background}" StrokeThickness="0" Padding="16,12,16,20">
            <Button Text="{Binding QuizButtonText}" Command="{Binding StartQuizCommand}" />
        </Border>
    </Grid>

</ContentPage>
