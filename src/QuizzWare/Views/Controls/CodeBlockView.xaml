<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:code="clr-namespace:QuizzWare.ViewModels.Code"
             x:Class="QuizzWare.Views.Controls.CodeBlockView">

    <Border Style="{StaticResource CodeBlock}" Padding="0,8">
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="LinesHost">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="code:CodeLineViewModel">
                        <Grid ColumnDefinitions="38,Auto" BackgroundColor="{Binding Background}" Padding="0,3,16,3">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TapCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Number}" Style="{StaticResource CodeLabel}" TextColor="{StaticResource TextMuted}"
                                   Opacity="0.6" HorizontalTextAlignment="End" Margin="0,0,12,0" />
                            <Label Grid.Column="1" FormattedText="{Binding Text}" Style="{StaticResource CodeLabel}"
                                   LineBreakMode="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Border>

</ContentView>
