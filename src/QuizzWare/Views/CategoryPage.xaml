<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizzWare.ViewModels"
             xmlns:controls="clr-namespace:QuizzWare.Views.Controls"
             x:Class="QuizzWare.Views.CategoryPage"
             x:DataType="vm:CategoryViewModel"
             Title="{Binding Name}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="16">

            <!-- Niveau de la catégorie -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                        <Border Style="{StaticResource Badge}" BackgroundColor="{Binding Color}">
                            <Label Text="{Binding Icon}" FontAttributes="Bold" FontSize="16" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding LevelText}" Style="{StaticResource HeaderLabel}" />
                            <Label Text="{Binding StatsText}" Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding Description}" Style="{StaticResource BodyLabel}" />
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Color}" />
                    <Label Text="{Binding XpText}" Style="{StaticResource MutedLabel}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Test de niveau : proposé tant qu'aucune leçon n'est validée -->
            <Border Style="{StaticResource Card}" Stroke="{StaticResource Warning}" IsVisible="{Binding CanTakePlacement}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartPlacementCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                    <Label Text="🎯" FontSize="28" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Test de niveau" Style="{StaticResource SubHeaderLabel}" />
                        <Label Text="{Binding PlacementText}" Style="{StaticResource MutedLabel}" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="{Binding PracticeText}" Command="{Binding PracticeCommand}" IsVisible="{Binding CanPractice}" />
            <Button Text="🎤 Mode entretien" Command="{Binding StartInterviewCommand}" IsVisible="{Binding CanInterview}"
                    Style="{StaticResource SecondaryButton}" />

            <!-- Entrée vers l'arbre des spécialisations -->
            <Border Style="{StaticResource Card}" Stroke="{StaticResource Primary}" IsVisible="{Binding HasSpecializations}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSpecializationsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                    <Label Text="🌳" FontSize="28" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Arbre des spécialisations" Style="{StaticResource SubHeaderLabel}" />
                        <Label Text="{Binding SpecializationsText}" Style="{StaticResource MutedLabel}" FontSize="13" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="Tronc commun" Style="{StaticResource MutedLabel}" FontAttributes="Bold" Margin="0,8,0,-8" />
            <controls:PathView Chapters="{Binding Chapters}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
