<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizzWare.ViewModels"
             x:Class="QuizzWare.Views.PremiumPage"
             x:DataType="vm:PremiumViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="16">

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="{Binding HeadlineIcon}" FontSize="48" HorizontalOptions="Center" />
                <Label Text="{Binding Headline}" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Stroke="{DynamicResource Warning}" IsVisible="{Binding HasReason}">
                <Label Text="{Binding ReasonText}" Style="{StaticResource SubHeaderLabel}" />
            </Border>

            <!-- Déjà abonné -->
            <Border Style="{StaticResource Card}" Stroke="{DynamicResource Success}" IsVisible="{Binding IsPremium}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="✅ Tu es Premium. Merci pour ton soutien !" Style="{StaticResource SubHeaderLabel}" />
                    <Button Text="Gérer mon abonnement" Command="{Binding ManageCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Abonnement pas encore proposé -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsComingSoon}">
                <Label Text="{Binding ComingSoonText}" FontSize="{DynamicResource FontSizeBody}" />
            </Border>

            <!-- Avantages -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding InterviewsText}" FontSize="{DynamicResource FontSizeBody}" />
                    <Label Text="{Binding CategoriesText}" FontSize="{DynamicResource FontSizeBody}" />
                    <Label Text="🌳 Toutes leurs spécialisations et leurs défis" FontSize="{DynamicResource FontSizeBody}" />
                    <Label Text="{Binding FreeText}" Style="{StaticResource MutedLabel}" FontSize="{DynamicResource FontSizeSmall}" />
                </VerticalStackLayout>
            </Border>

            <!-- Achat -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding CanSubscribe}">
                <Label Text="{Binding PriceText}" Style="{StaticResource HeaderLabel}" HorizontalOptions="Center" />
                <Button Text="S'abonner" Command="{Binding SubscribeCommand}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
                <Label Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="Center"
                       Text="{Binding TermsText}" />
            </VerticalStackLayout>

            <Button Text="Restaurer mes achats" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}"
                    IsVisible="{Binding CanSubscribe}" />

            <Label Text="🛠️ Version de développement : l'abonnement est simulé, aucun paiement n'est effectué."
                   Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsSimulated}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
